<?xml version="1.0" ?>
<robot name="romr_ros" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="standard_friction" value="1.0" />
<!--
  casterwheel_joint is a FIXED joint, so the caster never rolls; it is a skid
  that drags. At mu=1.0 against drive wheels at mu=1000 the robot fought itself
  on every turn and jammed against furniture repeatedly (48 wedge events in a
  5-minute mapping run, with actual velocity ~0 while cmd_vel commanded a turn).
  A low-friction skid is the right model. Note mu=0.0 with slip is too far:
  the robot then slides and yaws on its own while stationary (measured 21 deg
  of spontaneous rotation), which AMCL never sees because the wheel encoders
  report no motion, so localization silently goes stale.
-->
<xacro:property name="caster_friction" value="0.2" />
<!--
  Was 1000.0, about a thousand times realistic rubber-on-wood. That much grip
  turns any contact with an edge (a door frame, a table leg) into a violent
  pivot: the robot flipped onto its side after touching a door frame at
  0.12 m/s. 1.5 still gives ample traction without the whiplash.
-->
<xacro:property name="wheels_friction" value="1.5" />

<!--
  Contact parameters. None of these were set, so ODE used its defaults, and one
  of those defaults was doing real damage.

  maxVel is the contact CORRECTION velocity: when two bodies interpenetrate, ODE
  pushes them apart, capped at this speed. Its default is 0.01 m/s. The robot
  was measured creeping at a dead-constant 0.0106 m/s for 40 s (371 mm) and
  then stopping outright. That is not friction and not a command; it is ODE
  resolving a persistent overlap at exactly the capped rate. Setting maxVel to 0
  removes the corrective shove and lets the contact spring do the work.

  minDepth is the penetration ODE tolerates before correcting at all. A small
  allowance stops a resting wheel from being nudged every step by numerical
  noise.

  kp/kd are contact stiffness and damping. The default kp is 1e12, which is
  effectively rigid and makes the solver ring; 1e6 with kd 100 is the value used
  across ROS wheeled platforms and settles cleanly at this mass (8.4 kg).
-->
<xacro:property name="contact_kp" value="1000000.0" />
<xacro:property name="contact_kd" value="100.0" />
<xacro:property name="contact_min_depth" value="0.001" />
<xacro:property name="contact_max_vel" value="0.0" />

<xacro:macro name="contact_params">
  <kp>${contact_kp}</kp>
  <kd>${contact_kd}</kd>
  <minDepth>${contact_min_depth}</minDepth>
  <maxVel>${contact_max_vel}</maxVel>
</xacro:macro>

<!--
  selfCollide was true on the body and both wheels. The base_link mesh spans
  y +/-0.173 and the wheels mount at y +/-0.185, so their collision geometry
  interpenetrates and ODE generates continuous contact forces between parts of
  the same rigid robot. That pushed the robot around while it was idle: it slid
  ~0.5 m and yawed 20 deg with no command, which AMCL cannot see because the
  wheel encoders report nothing, so localization silently went stale.
-->
<gazebo reference="base_link">
  <mu1>${standard_friction}</mu1>
  <mu2>${standard_friction}</mu2>
  <xacro:contact_params />
  <selfCollide>false</selfCollide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="rightwheel_link">
  <mu1>${wheels_friction}</mu1>
  <mu2>${wheels_friction}</mu2>
  <xacro:contact_params />
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="leftwheel_link">
  <mu1>${wheels_friction}</mu1>
  <mu2>${wheels_friction}</mu2>
  <xacro:contact_params />
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="rearcaster_link">
  <mu1>${caster_friction}</mu1>
  <mu2>${caster_friction}</mu2>
  <xacro:contact_params />
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="casterwheel_link">
  <mu1>${caster_friction}</mu1>
  <mu2>${caster_friction}</mu2>
  <xacro:contact_params />
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="lidar_link">
  <mu1>${standard_friction}</mu1>
  <mu2>${standard_friction}</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="camerad435i_link">
  <mu1>${standard_friction}</mu1>
  <mu2>${standard_friction}</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="camerat265_link">
  <mu1>${standard_friction}</mu1>
  <mu2>${standard_friction}</mu2>
  <selfCollide>false</selfCollide>
</gazebo>


<gazebo reference="imu_link">
  <mu1>${standard_friction}</mu1>
  <mu2>${standard_friction}</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

</robot>
