# Backend configuration for a PUBLIC deployment (Render / Fly / Railway).
# The robot half is absent on such a host: navigation, teleoperation and vision
# return 503 with an explanation. The language, graph and retrieval endpoints work.

# --- access control. Leave PUBLIC_API_KEY empty locally to keep the service open.
PUBLIC_API_KEY=            # generate: openssl rand -hex 24
RATE_LIMIT_REQUESTS=10     # per client
RATE_LIMIT_WINDOW_SEC=3600
DAILY_BUDGET_CALLS=300     # hard ceiling on model-backed requests per UTC day

# --- who may call this service from a browser
ALLOWED_ORIGINS=https://your-app.vercel.app

# --- credentials (set these in the host's secret store, never in the repo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
PINECONE_API_KEY=
RAG_INDEX_NAME=multimodal-robot-autonomy
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multimodal-robot-autonomy
