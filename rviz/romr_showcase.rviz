Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Name: root
  Displays:

    # Faint ground grid, sized to the building. Dialled well down so the robot
    # reads as the subject rather than the graph paper.
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.18
      Color: 63; 191; 179
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Line Style:
        Line Width: 0.02
        Value: Lines
      Offset: {X: 0, Y: 0, Z: 0}
      Reference Frame: <Fixed Frame>

    # The occupancy map, kept dim so it grounds the scene without competing.
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.45
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Update Topic:
        Value: /map_updates

    # ROMR itself, from /robot_description.
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
      Update Interval: 0

    # Live lidar returns. Rainbow over intensity gives the scan visible depth,
    # which is the most legible sign that the robot is actually perceiving.
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Alpha: 1
      Decay Time: 0
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Invert Rainbow: false
      Position Transformer: XYZ
      Selectable: true

    # The route nav2 is currently following.
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 232; 163; 61
      Alpha: 1
      Line Style: Lines
      Buffer Length: 1
      Offset: {X: 0, Y: 0, Z: 0.01}

    # Where AMCL believes the robot is.
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL Pose
      Enabled: true
      Topic:
        Value: /amcl_pose
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 95; 224; 210
      Alpha: 0.9
      Shape: Arrow
      Covariance:
        Value: false

    # Off by default: useful when debugging frames, noisy in a screenshot.
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4

  Enabled: true
  Global Options:
    Background Color: 11; 15; 20
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      # Close three-quarter view: the robot fills the frame with enough map
      # around it to read as "somewhere", which is what a landing page wants.
      Distance: 4.2
      Pitch: 0.42
      Yaw: 0.86
      Focal Point: {X: -2.0, Y: -1.0, Z: 0.15}
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Invert Z Axis: false
      Target Frame: <Fixed Frame>
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Portrait
        Distance: 2.4
        Pitch: 0.30
        Yaw: 2.30
        Focal Point: {X: -2.0, Y: -1.0, Z: 0.20}
        Target Frame: <Fixed Frame>
      - Class: rviz_default_plugins/Orbit
        Name: Whole building
        Distance: 22
        Pitch: 1.20
        Yaw: 1.57
        Focal Point: {X: -4.0, Y: 1.0, Z: 0}
        Target Frame: <Fixed Frame>
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Floor plan
        Scale: 46
        X: -4.0
        Y: 1.0
        Angle: 0

Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 900
  Width: 1500
  QMainWindow State: ""
