# RViz layout for driving nav2 by hand.
#
# Built to answer one question: when the planner says "failed to create plan",
# what did it think the world looked like? The displays are ordered so that the
# usual causes are visible without turning anything on -- the inflated global
# costmap, the robot's actual footprint polygon, and AMCL's particle cloud.
#
#   scripts/nav2_rviz.sh          launches nav2 with this layout
#
# Use "2D Pose Estimate" to tell AMCL where the robot is, then "Nav2 Goal" to
# send it somewhere. Both are in the toolbar.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Costmap1
        - /Particle Cloud1
      Splitter Ratio: 0.55
    Tree Height: 620
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Splitter Ratio: 0.6
  - Class: rviz_common/Views
    Name: Views
  # Lifecycle control, and a goal-status readout that says whether nav2
  # accepted, is executing, or aborted -- worth watching alongside the plan.
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2

Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    # The saved map. Drawn behind everything else.
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false
      Value: true

    # THE ONE THAT EXPLAINS PLANNING FAILURES.
    #
    # This is the grid the planner actually searches, map plus inflation. A
    # goal sitting in the coloured band around a wall is unreachable no matter
    # how open it looks on the map underneath. Same for the robot's own cell:
    # if the start is lethal, the search never begins and you get "failed to
    # create plan" with no path drawn at all.
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Use Timestamp: false
      Value: true

    # The rolling window the controller steers inside. Off by default: it sits
    # on top of the global costmap and makes both harder to read.
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Local Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Use Timestamp: false
      Value: false

    # AMCL's hypotheses. A tight cluster means the filter has converged; a
    # cloud spread across the room means it has not, and every pose nav2 uses
    # is a guess. This is the display that tells you whether seeding worked.
    - Class: nav2_rviz_plugins/ParticleCloud
      Alpha: 1
      Arrow Length: 0.12
      Color: 0; 180; 255
      Enabled: true
      Max Arrow Length: 0.3
      Min Arrow Length: 0.02
      Name: Particle Cloud
      Shape: Arrow (Flat)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
      Value: true

    # Live laser returns. If these do not sit on top of the map's walls, the
    # robot is not where AMCL believes it is -- re-seed before doing anything
    # else, because every goal will be sent to the wrong place.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 85; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Collision Enabled: false
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Value: true

    # The footprint nav2 plans with: 0.521 x 0.608 m, offset forward of the
    # wheel axis. Worth comparing against the robot model -- a footprint that
    # does not match the body is why a robot either clips walls or refuses
    # doorways it would fit through.
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 0; 255; 128
      Enabled: true
      Name: Footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/published_footprint
      Value: true

    # The route the planner found. Absent means planning failed; present but
    # not being followed means the controller is the problem, not the planner.
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 255; 0
      Enabled: true
      Head Diameter: 0
      Line Style: Lines
      Line Width: 0.03
      Name: Global Plan
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Shaft Diameter: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0
      Line Style: Lines
      Line Width: 0.03
      Name: Local Plan
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Shaft Diameter: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_plan
      Value: true

    # Off by default: nine frames of axes bury the map. Tick it on only when
    # you need to check whether map -> odom exists.
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: false

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # 'map' is the frame goals are expressed in. Watching in 'odom' hides
    # exactly the localisation error this project exists to measure.
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # "2D Pose Estimate". Covariance here is deliberately tighter than nav2's
    # default 0.25: this is a click on a map you can see, not a blind guess,
    # and a loose seed leaves the filter searching a region it need not.
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.06
      Covariance y: 0.06
      Covariance yaw: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
    # "Nav2 Goal" -- sends a NavigateToPose action, the same entry point the
    # backend uses, so a goal that works here should work from the web UI.
    - Class: nav2_rviz_plugins/GoalTool

  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true

  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      # The building is 13.9 x 11.6 m; this frames it with room to spare.
      Scale: 55
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: -2
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Navigation 2:
    collapsed: false
  Tool Properties:
    collapsed: true
  Views:
    collapsed: true
  Height: 1000
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: true
